<?xml version="1.0" encoding="utf-8"?>
<!--
  Indoor positioning is optional, so the library merges no location, Bluetooth, or activity recognition permission
  into every app that shows a map. Apps that use positioning declare them in their own manifest.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
